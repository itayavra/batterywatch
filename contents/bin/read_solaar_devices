#!/usr/bin/env python3
"""read_solaar_devices - Solaar battery reader for the BatteryWatch plasmoid.

Enumerates Logitech HID++ devices and reads their batteries through Solaar's
own library (logitech_receiver, installed with every Solaar package) - no
device data is duplicated here. Prints JSON for SolaarProvider.qml:

  {"name", "serial", "percentage", "charging", "deviceType",
   "unitId", "connectionType", "bluetooth_address"}      readable device
  {"name", "serial", "blocked": true, "unblock_command"}  udev permission needed
  {"error": "solaar-missing", "hint": "..."}              library unusable

Devices that are offline, asleep or lack battery support report nothing and
drop until the next poll (stateless).
"""

from __future__ import annotations

import json
import os
import sys

# --debug enables stderr diagnostics; stdout stays pure JSON either way.
DEBUG = "--debug" in sys.argv
# --simulate runs without Solaar or hardware; both flags survive a re-exec.
SIMULATE = "--simulate" in sys.argv

# Set on the re-exec'd run so a useless interpreter cannot loop forever.
REEXEC_ENV = "_BW_READ_SOLAR_DEVICES_REEXEC"

# Where generated rule files are written; tests redirect this to a sandbox dir.
UDEV_RULES_DIR = "/etc/udev/rules.d"
UDEV_HEADER = '# Generated by the BatteryWatch widget. Do not edit manually; use the "Copy command" button.'
UDEV_RULE_FILENAME = "70-batterywatch-solaar.rules"

# uaccess is the operative grant: it gives the active session user read-write
# ACLs on the node, exactly what battery queries need. No MODE line - bare
# modes grant only the node's group (root) and the SSH/plugdev case needs a
# GROUP= change that upstream deliberately ships commented out.
_RULE_LINES = (
    'SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", TAG+="uaccess"',
    'SUBSYSTEM=="hidraw", ATTRS{idVendor}=="17ef", ATTRS{idProduct}=="6042", TAG+="uaccess"',
    'SUBSYSTEM=="hidraw", KERNELS=="0005:046D:*", TAG+="uaccess"',
)


def debug(message):
    if DEBUG:
        print(f"[batterywatch] {message}", file=sys.stderr)


def udev_rule_path():
    return f"{UDEV_RULES_DIR}/{UDEV_RULE_FILENAME}"


def udev_rule():
    """All transports Solaar supports, in one file, so one command fixes access."""
    return "\n".join(_RULE_LINES)


def udev_unblock_command():
    # Wrapped in `sudo sh -c '...'` so the heredoc pastes in sh/bash/zsh/fish
    path = udev_rule_path()
    return (
        f"sudo sh -c 'tee {path} >/dev/null <<EOF\n"
        f"{UDEV_HEADER}\n{udev_rule()}\n"
        f"EOF'\n"
        f"sudo udevadm control --reload-rules && sudo udevadm trigger"
    )


# ══════════════════════════════════════════════════════════════════════════
# schema - kind->deviceType mapping (pure, no solaar)
# ══════════════════════════════════════════════════════════════════════════
# DeviceTypes, based on DeviceUtils.js. Solaar kinds are NamedInts whose name
# is the kind string (mouse, keyboard, headset...); unknown kinds produce None,
# which maps to the widget's fallback battery icon.
_KIND_MAP = {
    "gamepad": "gamepad",
    "joystick": "gamepad",
    "mouse": "mouse",
    "keyboard": "keyboard",
    "numpad": "keyboard",
    "headset": "audio-headset",
    "headphones": "audio-headphones",
    "touchpad": "touchpad",
    "trackball": "touchpad",
    "tablet": "tablet",
}


def device_type(kind):
    """Maps Solaar's device kind (NamedInt name / str / None) to the widget type."""
    if kind is None:
        return None
    kind = getattr(kind, "name", kind)
    if not isinstance(kind, str):
        kind = str(kind)
    return _KIND_MAP.get(kind.lower())


# Solaar levels are ints that already carry the percentage it displays: real
# percentages, approximation enums (good=50, full=90...) and voltage estimates
# (hidpp20's curve) alike - int() is all that is needed.
def percentage(level):
    """Clamps any Solaar level int (NamedInt/IntEnum/int) to 0..100."""
    if level is None:
        return None
    return max(0, min(100, int(level)))


# ══════════════════════════════════════════════════════════════════════════
# lib - loading Solaar's logitech_receiver (system/pip/pipx installs)
# ══════════════════════════════════════════════════════════════════════════
class SolaarNotImportable(Exception):
    """The Solaar library cannot be used from this interpreter."""


def parse_shebang_python(line):
    """The python path a shebang line points at, or None.

    Only a direct path is accepted: `#!/usr/bin/env python` resolves through
    PATH, not the Solaar environment. Flags after the interpreter are fine;
    the last python-looking token wins.
    """
    tokens = line.split()
    candidates = [token for token in tokens if os.path.basename(token).startswith("python")]
    if not candidates:
        return None
    argv0 = candidates[-1]
    if os.path.sep not in argv0:
        return None
    base = os.path.basename(argv0)
    if base != "python" and not base.startswith("python3"):
        return None
    return argv0


def solaar_interpreter():
    """The python behind the installed solaar CLI (for pipx/venv installs)."""
    import shutil

    binary = shutil.which("solaar")
    if binary is None:
        return None
    try:
        with open(binary, "rb") as stream:
            first = stream.readline(256)
    except OSError:
        return None
    if not first.startswith(b"#!"):
        return None
    return parse_shebang_python(first[2:].decode("utf-8", "replace").strip())


def load_modules():
    """Imports logitech_receiver; re-execs with Solaar's python for pipx installs."""
    try:
        from logitech_receiver import base, device, receiver

        return _Modules(base, device, receiver)
    except ImportError:
        pass
    python = solaar_interpreter()
    if python and python != sys.executable and os.path.isfile(python):
        if os.environ.get(REEXEC_ENV):
            raise SolaarNotImportable("Solaar's library cannot be imported even by Solaar's own interpreter")
        debug(f"solaar library not importable here, re-exec with {python}")
        os.environ[REEXEC_ENV] = "1"
        os.execve(python, [python, os.path.abspath(__file__), *sys.argv[1:]], os.environ)
    raise SolaarNotImportable(
        "Solaar's Python library (logitech_receiver) is not importable. "
        "Install Solaar via your distribution's package manager, or `python3 -m pip install solaar`."
    )


# ══════════════════════════════════════════════════════════════════════════
# loop - mirrors Solaar CLI's device enumeration, reads batteries
# ══════════════════════════════════════════════════════════════════════════
class _Blocked:
    """A hidraw node Solaar wants but this helper may not open."""

    def __init__(self, path):
        self.path = path


def _read(device, attr, default=None):
    """Reads a property defensively: raises on these (kind/unitId/serial do
    HID++ I/O on a fresh Device) must not cost the other devices of a run."""
    try:
        return getattr(device, attr)
    except Exception:
        return default


class _Modules:
    """Namespace so the loop code can be tested without Solaar installed."""

    def __init__(self, base, device, receiver):
        self.base = base
        self.device = device
        self.receiver = receiver


def open_items(modules, info):
    """One DeviceInfo -> its Receiver/Device, or a _Blocked marker.

    Same enumeration as Solaar's CLI: centurion dongles, plain receivers, and
    receiver-less (wired/Bluetooth) devices. Errors never kill the run.
    """
    try:
        if getattr(info, "centurion", False):
            item = modules.device.create_centurion_receiver(modules.base, info)
            if item is not None:
                item.notify_devices()
                yield item
                return
        if info.isDevice:
            item = modules.device.create_device(modules.base, info)
        else:
            item = modules.receiver.create_receiver(modules.base, info)
        if item is not None:
            yield item
        else:
            yield from _yield_blocked(info.path)
    except PermissionError:
        # the raise itself is the permission proof; no probe needed
        yield from _yield_blocked(info.path, denied=True)
    except Exception as error:
        # Solaar's creators already log details; a receiver that fails some
        # other way drops silently instead of poisoning the whole run.
        debug(f"{info.path}: creation failed ({error!r}); skipping")


def _yield_blocked(path, denied=False):
    """Yields a _Blocked marker after probing the node (when not already known).

    Upstream creators swallow open failures into None; the probe tells a
    missing permission apart from a device that vanished mid-run (which is
    silently skipped - retried on the next poll).
    """
    if not denied:
        try:
            os.open(path, os.O_RDWR | os.O_NONBLOCK).close()
        except PermissionError:
            denied = True
        except OSError:
            return
    debug(f"{path}: open denied; reporting blocked")
    yield _Blocked(path)


def device_entry(device):
    """Reads one reachable device; its widget JSON dict, or None (dropped)."""
    name = getattr(device, "name", None) or "Logitech device"
    try:
        online = device.ping()
    except Exception as error:
        debug(f"{name}: ping failed ({error!r}), dropping")
        return None
    if not online:
        debug(f"{name}: offline, dropping")
        return None
    try:
        battery = device.battery()
        is_charging = bool(battery.charging()) if battery is not None else False
    except Exception as error:
        debug(f"{name}: battery read failed ({error!r}), dropping")
        return None
    if battery is None or battery.level is None:
        debug(f"{name}: no battery level, dropping")
        return None
    level = percentage(battery.level)
    # kind/unitId/serial are lazy properties that do HID++ I/O on a freshly
    # created Device; read each defensively and independently, so a raise
    # costs one field, not the device - and never discards a value that
    # already succeeded.
    identity = _read(device, "serial")
    kind = _read(device, "kind")
    unit_id = _read(device, "unitId")
    if not identity:
        for fallback in (
            _read(device, "hid_serial"),
            unit_id,
            _read(device, "wpid"),
        ):
            if fallback:
                identity = fallback
                break
    if not identity:
        identity = f"{name} ({_read(device, 'path') or 'no path'})"
    bluetooth = bool(_read(device, "bluetooth", False))
    return {
        "name": name,
        "serial": identity,
        "percentage": level,
        "charging": is_charging,
        "deviceType": device_type(kind),
        # unitId is the device's transport-independent identity; the widget
        # ignores it, but dedupe needs it to collapse multipoint connections.
        # Its extra HID++ query per device per poll is deliberate: it is the
        # only cross-transport key (see _fold).
        "unitId": unit_id,
        # 2 = bluetooth (selects the widget's disconnect action), 1 = wireless;
        # cable-connected reports as wireless + charging, matching the HID
        # provider's wired devices.
        "connectionType": 2 if bluetooth else 1,
        "bluetooth_address": _read(device, "hid_serial") if bluetooth else None,
    }


def receiver_entries(receiver):
    """One receiver -> its paired devices' JSON dicts (stateless walk)."""
    entries = []
    # The whole walk is guarded: iterating a receiver does register reads
    # (Receiver.__iter__ -> count()) that can fail mid-iteration, dropping
    # the remaining devices for this run only.
    try:
        for paired in receiver:
            if paired is None:
                continue
            entry = device_entry(paired)
            if entry is not None:
                entries.append(entry)
    except Exception as error:
        debug(f"{receiver}: receiver walk failed ({error!r})")
    return entries


# HID++ unit id Solaar keeps for devices that have no unique unit serial
# ("distinguishes within a model", per Solaar itself) - not usable as identity.
_GENERIC_UNIT_ID = "00010000"


def _fold(entry, entries, by_identity):
    """Appends an entry unless the same device is already listed.

    Keyed by non-generic unitId with the serial as fallback, so a device
    reachable over several transports at once (multipoint: receiver +
    Bluetooth) is reported once - but only when both instances report a
    matching, actually-unique unitId; a side that reports none (or
    the generic placeholder) never collapses with anything. The Bluetooth
    instance wins the collapse: its MAC identity matches UPower's and it
    keeps the disconnect action.
    """
    unit = entry.get("unitId") or ""
    key = entry["serial"] if unit.upper() == _GENERIC_UNIT_ID else unit or entry["serial"]
    existing = by_identity.get(key)
    if existing is not None:
        if entry.get("connectionType") == 2 and entries[existing].get("connectionType") != 2:
            entries[existing] = entry
        return
    by_identity[key] = len(entries)
    entries.append(entry)


def collect(modules=None):
    """Device entries for every battery Solaar can read, plus blocked markers."""
    if modules is None:
        modules = load_modules()
    entries = []
    by_identity = {}
    blocked_reported = False
    try:
        for info in modules.base.receivers_and_devices():
            for item in open_items(modules, info):
                if isinstance(item, _Blocked):
                    # One marker per run: the rule is vendor-wide, so a second
                    # blocked node adds nothing to the copy-command flow.
                    if blocked_reported:
                        continue
                    blocked_reported = True
                    entries.append(
                        {
                            "name": f"Logitech device ({item.path})",
                            "serial": item.path,
                            "blocked": True,
                            "unblock_command": udev_unblock_command(),
                        }
                    )
                elif hasattr(item, "count"):  # Receiver / CenturionReceiver
                    for entry in receiver_entries(item):
                        _fold(entry, entries, by_identity)
                else:
                    entry = device_entry(item)
                    if entry is not None:
                        _fold(entry, entries, by_identity)
    finally:
        # Release every handle we opened; close() is idempotent and safe.
        try:
            for instance in list(modules.device.Device.instances):
                instance.close()
        except Exception as error:
            debug(f"cleanup failed ({error!r})")
    return entries


# ══════════════════════════════════════════════════════════════════════════
# cli - JSON output consumed by the widget
# ══════════════════════════════════════════════════════════════════════════
# Testing mode (no hardware): fake devices that mirror real behavior - they
# look blocked until the helper's udev rule exists, then report their battery.
_SIMULATE_DEVICES = [
    {"name": "MX Master 3S", "serial": "sim-mx-master-3s", "percentage": 72, "charging": False, "deviceType": "mouse"},
    {"name": "G733", "serial": "sim-g733", "percentage": 38, "charging": True, "deviceType": "audio-headset"},
    {"name": "MX Keys S", "serial": "sim-mx-keys-s", "percentage": 90, "charging": False, "deviceType": "keyboard"},
]


def simulate():
    if os.path.exists(udev_rule_path()):
        return _SIMULATE_DEVICES
    return [
        {
            key: device[key]
            for key in ("name", "serial", "deviceType")
        }
        | {"blocked": True, "unblock_command": udev_unblock_command()}
        for device in _SIMULATE_DEVICES
    ]


def main():
    if SIMULATE:
        print(json.dumps(simulate()))
        return
    try:
        print(json.dumps(collect()))
    except SolaarNotImportable as unavailable:
        print(json.dumps({"error": "solaar-missing", "hint": str(unavailable)}))
    except Exception as error:  # e.g. pyudev breakage; the traceback stays on stderr
        print(json.dumps({"error": "solaar-error", "hint": repr(error)}))


if __name__ == "__main__":
    main()
