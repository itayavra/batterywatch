#!/usr/bin/env python3
"""read_solaar_devices - Solaar battery reader for the BatteryWatch plasmoid.

Enumerates Logitech HID++ devices and reads their batteries through Solaar's
own library (logitech_receiver, installed with every Solaar package) - no
device data is duplicated here. Prints JSON for SolaarProvider.qml:

  {"name", "serial", "percentage", "charging", "deviceType",
   "unitId", "connectionType", "bluetooth_address"}      readable device
  {"name", "serial", "blocked": true, "unblock_command"}  udev permission needed
  {"error": "solaar-missing", "hint": "..."}              library unusable

Devices that are offline, asleep or lack battery support report nothing and
drop until the next poll (stateless).
"""

# ── file map ──────────────────────────────────────────────────────────────
# A poll: main() picks a "runner" (the way to reach logitech_receiver) and
# collect() reads the batteries through it. The runner is one of:
#   native        this interpreter already has the library
#   python:X      re-exec into interpreter X   (load_modules / exec_into)
#   flatpak       run inside Solaar's sandbox  (collect_flatpak)
#
# Sections (in file order):
#   discovery     pipx/conda dirs + every plausible `solaar` launcher ->
#                 candidate_interpreters (who to probe), the probe
#                 (imports_solaar), and the hint when nothing works
#                 (solaar_missing_hint)
#   runner cache  the token file (runner_cache_path / cached_runner /
#                 write_runner_cache / clear_runner_cache), the re-exec
#                 jump (exec_into), and load_modules - where the cache is
#                 consulted and the native-import decision is made
#   flatpak       detect the app (flatpak_solaar_app), run the helper
#                 inside it (collect_via_flatpak), and the cached/fallback
#                 entry (collect_flatpak)
#   loop          collect() walks devices - open_items / device_entry /
#                 receiver_entries / _fold - into widget JSON
#   cli           simulate() and main(), the dispatcher
#
# Where the cache is touched (the three moments):
#   read     main()            -> cached runner == "flatpak"?
#            load_modules()    -> cached "python:..."?
#   write    load_modules()    after a re-exec'd run imports OK (positive-only)
#            collect_flatpak() after a Flatpak run returns JSON
#   clear    only when a cached runner fails (never on a plain miss)
#
# Flags that survive a re-exec (defined near the top):
#   REEXEC   this run is already a re-exec - one hop, no second candidate
#   CACHED   this hop came FROM the cache - failure = stale token, so
#            clear + rediscover instead of raising
#   FLATPAK  we are inside the sandbox - never hand off or touch the cache
# ──────────────────────────────────────────────────────────────────────────

from __future__ import annotations

import glob
import json
import os
import shutil
import subprocess
import sys

# --debug enables stderr diagnostics; stdout stays pure JSON either way.
DEBUG = "--debug" in sys.argv
# --simulate runs without Solaar or hardware; both flags survive an interpreter
# re-exec, and --debug is also forwarded into the Flatpak sandbox.
SIMULATE = "--simulate" in sys.argv

# Set on the re-exec'd run so a useless interpreter cannot loop forever.
REEXEC_ENV = "_BW_READ_SOLAR_DEVICES_REEXEC"
# Set when the re-exec came from the cached runner, so a stale token is
# forgotten (and rediscovered) instead of looping.
CACHED_ENV = "_BW_READ_SOLAR_DEVICES_CACHED"
# Set on the run inside Solaar's Flatpak so it never tries to re-enter itself.
FLATPAK_ENV = "_BW_READ_SOLAR_DEVICES_FLATPAK"

# Flathub app id of Solaar: its sandbox carries both the library and the
# hidraw/device permissions, so this helper can be executed inside it.
FLATPAK_SOLAAR_ID = "io.github.pwr_solaar.solaar"

# Runner cache file (see runner_cache_path): remembers which known-good way to
# reach logitech_receiver (`python:<abs path>` or `flatpak`) so subsequent
# polls skip the interpreter probes and Flatpak detection entirely.
RUNNER_CACHE_NAME = "batterywatch-solaar-runner"

# Where generated rule files are written; tests redirect this to a sandbox dir.
UDEV_RULES_DIR = "/etc/udev/rules.d"
UDEV_HEADER = '# Generated by the BatteryWatch widget. Do not edit manually; use the "Copy command" button.'
UDEV_RULE_FILENAME = "70-batterywatch-solaar.rules"

# uaccess is the operative grant: it gives the active session user read-write
# ACLs on the node, exactly what battery queries need. No MODE line - bare
# modes grant only the node's group (root) and the SSH/plugdev case needs a
# GROUP= change that upstream deliberately ships commented out.
_RULE_LINES = (
    'SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", TAG+="uaccess"',
    'SUBSYSTEM=="hidraw", ATTRS{idVendor}=="17ef", ATTRS{idProduct}=="6042", TAG+="uaccess"',
    'SUBSYSTEM=="hidraw", KERNELS=="0005:046D:*", TAG+="uaccess"',
)


def debug(message):
    if DEBUG:
        print(f"[batterywatch] {message}", file=sys.stderr)


def udev_rule_path():
    return f"{UDEV_RULES_DIR}/{UDEV_RULE_FILENAME}"


def udev_rule():
    """All transports Solaar supports, in one file, so one command fixes access."""
    return "\n".join(_RULE_LINES)


def udev_unblock_command():
    # Wrapped in `sudo sh -c '...'` so the heredoc pastes in sh/bash/zsh/fish
    path = udev_rule_path()
    return (
        f"sudo sh -c 'tee {path} >/dev/null <<EOF\n"
        f"{UDEV_HEADER}\n{udev_rule()}\n"
        f"EOF'\n"
        f"sudo udevadm control --reload-rules && sudo udevadm trigger"
    )


# ══════════════════════════════════════════════════════════════════════════
# schema - kind->deviceType mapping (pure, no solaar)
# ══════════════════════════════════════════════════════════════════════════
# DeviceTypes, based on DeviceUtils.js. Solaar kinds are NamedInts whose name
# is the kind string (mouse, keyboard, headset...); unknown kinds produce None,
# which maps to the widget's fallback battery icon.
_KIND_MAP = {
    "gamepad": "gamepad",
    "joystick": "gamepad",
    "mouse": "mouse",
    "keyboard": "keyboard",
    "numpad": "keyboard",
    "headset": "audio-headset",
    "headphones": "audio-headphones",
    "touchpad": "touchpad",
    "trackball": "touchpad",
    "tablet": "tablet",
}


def device_type(kind):
    """Maps Solaar's device kind (NamedInt name / str / None) to the widget type."""
    if kind is None:
        return None
    kind = getattr(kind, "name", kind)
    if not isinstance(kind, str):
        kind = str(kind)
    return _KIND_MAP.get(kind.lower())


# Solaar levels are ints that already carry the percentage it displays: real
# percentages, approximation enums (good=50, full=90...) and voltage estimates
# (hidpp20's curve) alike - int() is all that is needed.
def percentage(level):
    """Clamps any Solaar level int (NamedInt/IntEnum/int) to 0..100."""
    if level is None:
        return None
    return max(0, min(100, int(level)))


# ══════════════════════════════════════════════════════════════════════════
# lib - loading Solaar's logitech_receiver (system/pip/pipx installs)
# ══════════════════════════════════════════════════════════════════════════
class SolaarNotImportable(Exception):
    """The Solaar library cannot be used from this interpreter."""


def parse_shebang_python(line):
    """The python path a shebang line points at, or None.

    Only a direct path is accepted: `#!/usr/bin/env python` resolves through
    PATH, not the Solaar environment. Flags after the interpreter are fine;
    the last python-looking token wins.
    """
    tokens = line.split()
    candidates = [token for token in tokens if os.path.basename(token).startswith("python")]
    if not candidates:
        return None
    argv0 = candidates[-1]
    if os.path.sep not in argv0:
        return None
    base = os.path.basename(argv0)
    if base != "python" and not base.startswith("python3"):
        return None
    return argv0


def read_shebang(path):
    """The interpreter a script's `#!` line points at, or None for binaries."""
    try:
        with open(path, "rb") as stream:
            first = stream.readline(256)
    except OSError:
        return None
    if not first.startswith(b"#!"):
        return None
    return parse_shebang_python(first[2:].decode("utf-8", "replace").strip())


def pipx_venvs_dir():
    """pipx's venv root, honoring PIPX_HOME and XDG_DATA_HOME."""
    pipx_home = os.environ.get("PIPX_HOME")
    if pipx_home:
        return f"{pipx_home}/venvs"
    data_home = os.environ.get("XDG_DATA_HOME") or f"{os.path.expanduser('~')}/.local/share"
    return f"{data_home}/pipx/venvs"


def conda_bin_dirs():
    """Conda environment bin dirs: the active env first, then common defaults."""
    home = os.path.expanduser("~")
    dirs = []
    prefix = os.environ.get("CONDA_PREFIX")
    if prefix:
        dirs.append(f"{prefix}/bin")
    executable = os.environ.get("CONDA_EXE")
    if executable:
        dirs.append(os.path.dirname(executable))
    dirs.extend((f"{home}/miniconda3/bin", f"{home}/anaconda3/bin"))
    return dirs


def solaar_launchers():
    """Every plausible `solaar` entry point: PATH first, then known prefixes.

    PATH alone misses a pipx install whose desktop entry works but whose
    `~/.local/bin` is absent from a GUI session's PATH, `/usr/local` installs,
    conda, and the `make install_pipx` layout. The Flatpak export is namespaced
    (io.github.pwr_solaar.solaar) so it never appears as `solaar` here at all.
    """
    found = []
    which = shutil.which("solaar")
    if which:
        found.append(which)
    home = os.path.expanduser("~")
    patterns = [
        f"{home}/.local/bin/solaar",
        "/usr/local/bin/solaar",
        "/usr/bin/solaar",
        "/opt/solaar/bin/solaar",
        f"{pipx_venvs_dir()}/*/bin/solaar",
    ]
    patterns.extend(f"{directory}/solaar" for directory in conda_bin_dirs())
    for pattern in patterns:
        found.extend(sorted(glob.glob(pattern)))
    # Keep discovery order; dedupe literal paths only, never resolve symlinks.
    seen, result = set(), []
    for path in found:
        if path not in seen and os.path.isfile(path):
            seen.add(path)
            result.append(path)
    return result


def candidate_interpreters():
    """Interpreters worth probing for logitech_receiver, most likely first.

    The current interpreter, then each launcher's shebang interpreter (native,
    pip, pipx, venv, Nix), then pipx/conda/venv pythons, then the usual system
    and user locations. Dedupe keys on the literal path, never realpath: a
    venv's `bin/python` is a symlink to its base interpreter, and `argv0` is
    exactly what decides a venv's `sys.prefix`, so collapsing by realpath would
    hide the very interpreter that carries the library (the pipx case).
    """
    home = os.path.expanduser("~")
    candidates = [sys.executable]
    for launcher in solaar_launchers():
        python = read_shebang(launcher)
        if python:
            candidates.append(python)
    candidates.extend(sorted(glob.glob(f"{pipx_venvs_dir()}/*/bin/python")))
    virtual_env = os.environ.get("VIRTUAL_ENV")
    if virtual_env:
        candidates.append(f"{virtual_env}/bin/python")
    candidates.extend(f"{directory}/python" for directory in conda_bin_dirs())
    candidates.extend([
        shutil.which("python3"),
        shutil.which("python"),
        "/usr/bin/python3",
        "/usr/local/bin/python3",
        f"{home}/.local/bin/python3",
    ])
    seen, result = set(), []
    for path in candidates:
        if not path or not os.path.isfile(path):
            continue
        if path in seen:
            continue
        seen.add(path)
        result.append(path)
    return result


def imports_solaar(python):
    """True when `python` can run the exact imports this helper depends on."""
    try:
        done = subprocess.run(
            [python, "-c",
             "import logitech_receiver.base, logitech_receiver.device, logitech_receiver.receiver"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return done.returncode == 0


def solaar_missing_hint(error=None):
    """User-facing explanation naming what was tried, plus the real cause."""
    detail = f" ({error})" if error else ""
    return (
        "Solaar's Python library (logitech_receiver) is not importable from any "
        "interpreter found on this system" + detail + ". "
        "Install Solaar via your distribution's package manager, or "
        "`python3 -m pip install solaar`. A Flatpak Solaar is used through its "
        "own sandbox when available; a Snap Solaar is sandboxed and not "
        "reachable from the widget."
    )


# ══════════════════════════════════════════════════════════════════════════
# runner cache - remember the working interpreter/flatpak between polls
# ══════════════════════════════════════════════════════════════════════════
# Tokens are positive-only: a failure is never recorded, so a later Solaar
# install (or a change of default interpreter) is still discovered.
def runner_cache_path():
    """Where the discovered runner is remembered; $XDG_RUNTIME_DIR preferred.

    A per-session tmpfs, writable without a home directory; ~/.cache (or
    $XDG_CACHE_HOME) is the fallback for desktops without a runtime dir.
    """
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime and os.access(runtime, os.W_OK):
        return f"{runtime}/{RUNNER_CACHE_NAME}"
    cache = os.environ.get("XDG_CACHE_HOME") or f"{os.path.expanduser('~')}/.cache"
    return f"{cache}/batterywatch/{RUNNER_CACHE_NAME}"


def cached_runner():
    """The recorded runner token, or None. Staleness is caught when used.

    Returns "flatpak", "python:/abs/path" (if that path still exists), or
    None when the file is absent or unreadable. A malformed file is ignored
    and eventually overwritten.
    """
    try:
        with open(runner_cache_path(), "r", encoding="utf-8") as stream:
            token = stream.read().strip()
    except OSError:
        return None
    if not token:
        return None
    if token == "flatpak":
        return "flatpak"
    if token.startswith("python:"):
        python = token.split(":", 1)[1]
        if os.path.isfile(python):
            return f"python:{python}"
    return None


def write_runner_cache(token):
    """Records a runner that worked; best-effort (a full cache dir is fine)."""
    path = runner_cache_path()
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as stream:
            stream.write(token)
    except OSError as error:
        debug(f"cannot write runner cache ({error!r})")


def clear_runner_cache():
    """Forgets a runner that stopped working; best-effort."""
    try:
        os.remove(runner_cache_path())
    except FileNotFoundError:
        pass
    except OSError as error:
        debug(f"cannot clear runner cache ({error!r})")


def exec_into(python, script, cached):
    """Re-execs this script with `python`; `cached` marks the cache-created hop.

    A hop from the runner cache sets CACHED_ENV, so the re-exec'd run can
    forget a stale token instead of looping on it.
    """
    debug(f"solaar library not importable here, re-exec with {python}"
          f"{' (cached)' if cached else ''}")
    environment = dict(os.environ)
    environment[REEXEC_ENV] = "1"
    if cached:
        environment[CACHED_ENV] = "1"
    else:
        environment.pop(CACHED_ENV, None)
    try:
        os.execve(python, [python, script, *sys.argv[1:]], environment)
    except OSError as error:
        debug(f"re-exec with {python} failed ({error!r}); continuing")


def load_modules():
    """Imports logitech_receiver, re-execing into a Python that has it.

    Tries this interpreter first, then every interpreter discovered from the
    installed Solaar launchers and venvs, so native, pip, pipx, conda and Nix
    installs all resolve to whichever Python actually carries the library.

    The runner cache short-circuits that probe on later polls: once an
    interpreter imported successfully the next run re-execs into it directly.
    Stale entries are caught by CACHED_ENV and forgotten, falling back to
    full rediscovery - never a loop.
    """
    try:
        from logitech_receiver import base, device, receiver
    except ImportError as error:
        import_error = error
    else:
        if os.environ.get(REEXEC_ENV) and not os.environ.get(FLATPAK_ENV):
            write_runner_cache(f"python:{sys.executable}")
        return _Modules(base, device, receiver)

    cached = cached_runner()
    if cached and cached.startswith("python:"):
        python = cached.split(":", 1)[1]
        if python == sys.executable:
            # The cached runner is this interpreter, which just failed to
            # import: the token is stale. Clear it and rediscover as if newly
            # started, so a changed default or a fresh install wins.
            clear_runner_cache()
            if os.environ.get(CACHED_ENV):
                os.environ.pop(REEXEC_ENV, None)
                os.environ.pop(CACHED_ENV, None)
        else:
            script = os.path.abspath(__file__)
            if os.path.isfile(script):
                exec_into(python, script, cached=True)
            debug(f"cached interpreter {python} unusable; rediscovering")
            clear_runner_cache()

    script = os.path.abspath(__file__)
    if os.path.isfile(script):
        for python in candidate_interpreters():
            # literal comparison, not realpath: a venv python shares its
            # realpath with the base interpreter but is a different env
            if python == sys.executable:
                continue
            if not imports_solaar(python):
                continue
            if os.environ.get(REEXEC_ENV):
                raise SolaarNotImportable(
                    "Solaar's library cannot be imported even by Solaar's own interpreter"
                )
            exec_into(python, script, cached=False)
    raise SolaarNotImportable(solaar_missing_hint(import_error))


# ══════════════════════════════════════════════════════════════════════════
# flatpak - execute this helper inside Solaar's sandbox
# ══════════════════════════════════════════════════════════════════════════
def flatpak_solaar_app():
    """(flatpak, app_id) when Solaar's Flathub app is installed, else None.

    The sandboxed library is unreachable from the host interpreter, so the
    only faithful way to read battery data is to run inside the sandbox.
    """
    if os.environ.get(FLATPAK_ENV):
        return None
    flatpak = shutil.which("flatpak")
    if not flatpak:
        return None
    try:
        done = subprocess.run(
            [flatpak, "info", FLATPAK_SOLAAR_ID],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=15,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if done.returncode != 0:
        return None
    return flatpak, FLATPAK_SOLAAR_ID


def collect_via_flatpak(flatpak, app_id):
    """Runs this same helper inside Solaar's sandbox and returns its JSON.

    The script is fed on stdin (`python3 -`), so nothing needs to be visible
    to the sandbox, and the run inherits Solaar's own hidraw/device access.
    """
    try:
        with open(os.path.abspath(__file__), "rb") as stream:
            source = stream.read()
    except OSError as error:
        debug(f"cannot read own script for the flatpak re-run ({error!r})")
        return None
    command = [flatpak, "run", "--command=python3", app_id, "-"]
    if DEBUG:
        # argv inside the sandbox becomes ['-', '--debug']: keep diagnostics
        command.append("--debug")
    environment = dict(os.environ, **{FLATPAK_ENV: "1"})
    try:
        done = subprocess.run(
            command,
            input=source,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=120,
            env=environment,
        )
    except (OSError, subprocess.SubprocessError) as error:
        debug(f"flatpak run failed ({error!r})")
        return None
    if done.returncode != 0:
        debug("flatpak helper exited "
              f"{done.returncode}: {done.stderr.decode('utf-8', 'replace').strip()}")
        return None
    try:
        return json.loads(done.stdout.decode("utf-8", "replace").strip())
    except ValueError:
        debug("flatpak helper did not produce JSON")
        return None


def collect_flatpak():
    """Collects through a Flatpak Solaar's sandbox, if one is usable.

    A cached `flatpak` token skips detection and (part of) the host probing
    on later polls, but is re-validated by actually running the helper and
    cleared when it stops working. Returns the JSON document or None.
    """
    if os.environ.get(FLATPAK_ENV):
        # Inside the sandbox we never hand off (or touch the cache): even a
        # future manifest that grants home/runtime access must keep the inner
        # run read-only towards the host-side token.
        return None
    if cached_runner() == "flatpak":
        flatpak = shutil.which("flatpak")
        if not flatpak:
            clear_runner_cache()
            return None
        result = collect_via_flatpak(flatpak, FLATPAK_SOLAAR_ID)
        if result is None:
            debug("cached flatpak runner unusable; forgetting it")
            clear_runner_cache()
        return result
    detected = flatpak_solaar_app()
    if detected is None:
        return None
    result = collect_via_flatpak(*detected)
    if result is not None:
        write_runner_cache("flatpak")
    return result


# ══════════════════════════════════════════════════════════════════════════
# loop - mirrors Solaar CLI's device enumeration, reads batteries
# ══════════════════════════════════════════════════════════════════════════
class _Blocked:
    """A hidraw node Solaar wants but this helper may not open."""

    def __init__(self, path):
        self.path = path


def _read(device, attr, default=None):
    """Reads a property defensively: raises on these (kind/unitId/serial do
    HID++ I/O on a fresh Device) must not cost the other devices of a run."""
    try:
        return getattr(device, attr)
    except Exception:
        return default


class _Modules:
    """Namespace so the loop code can be tested without Solaar installed."""

    def __init__(self, base, device, receiver):
        self.base = base
        self.device = device
        self.receiver = receiver


def open_items(modules, info):
    """One DeviceInfo -> its Receiver/Device, or a _Blocked marker.

    Same enumeration as Solaar's CLI: centurion dongles, plain receivers, and
    receiver-less (wired/Bluetooth) devices. Errors never kill the run.
    """
    try:
        if getattr(info, "centurion", False):
            item = modules.device.create_centurion_receiver(modules.base, info)
            if item is not None:
                item.notify_devices()
                yield item
                return
        if info.isDevice:
            item = modules.device.create_device(modules.base, info)
        else:
            item = modules.receiver.create_receiver(modules.base, info)
        if item is not None:
            yield item
        else:
            yield from _yield_blocked(info.path)
    except PermissionError:
        # the raise itself is the permission proof; no probe needed
        yield from _yield_blocked(info.path, denied=True)
    except Exception as error:
        # Solaar's creators already log details; a receiver that fails some
        # other way drops silently instead of poisoning the whole run.
        debug(f"{info.path}: creation failed ({error!r}); skipping")


def _yield_blocked(path, denied=False):
    """Yields a _Blocked marker after probing the node (when not already known).

    Upstream creators swallow open failures into None; the probe tells a
    missing permission apart from a device that vanished mid-run (which is
    silently skipped - retried on the next poll).
    """
    if not denied:
        try:
            os.open(path, os.O_RDWR | os.O_NONBLOCK).close()
        except PermissionError:
            denied = True
        except OSError:
            return
    debug(f"{path}: open denied; reporting blocked")
    yield _Blocked(path)


def device_entry(device):
    """Reads one reachable device; its widget JSON dict, or None (dropped)."""
    name = getattr(device, "name", None) or "Logitech device"
    try:
        online = device.ping()
    except Exception as error:
        debug(f"{name}: ping failed ({error!r}), dropping")
        return None
    if not online:
        debug(f"{name}: offline, dropping")
        return None
    try:
        battery = device.battery()
        is_charging = bool(battery.charging()) if battery is not None else False
        # lazy HID++ read; read inside the guard so a raise costs one device
        raw_level = battery.level if battery is not None else None
    except Exception as error:
        debug(f"{name}: battery read failed ({error!r}), dropping")
        return None
    if battery is None or raw_level is None:
        debug(f"{name}: no battery level, dropping")
        return None
    level = percentage(raw_level)
    # kind/unitId/serial are lazy properties that do HID++ I/O on a freshly
    # created Device; read each defensively and independently, so a raise
    # costs one field, not the device - and never discards a value that
    # already succeeded.
    identity = _read(device, "serial")
    kind = _read(device, "kind")
    unit_id = _read(device, "unitId")
    if not identity:
        for fallback in (
            _read(device, "hid_serial"),
            unit_id,
            _read(device, "wpid"),
        ):
            if fallback:
                identity = fallback
                break
    if not identity:
        identity = f"{name} ({_read(device, 'path') or 'no path'})"
    bluetooth = bool(_read(device, "bluetooth", False))
    return {
        "name": name,
        "serial": identity,
        "percentage": level,
        "charging": is_charging,
        "deviceType": device_type(kind),
        # unitId is the device's transport-independent identity; the widget
        # ignores it, but dedupe needs it to collapse multipoint connections.
        # Its extra HID++ query per device per poll is deliberate: it is the
        # only cross-transport key (see _fold).
        "unitId": unit_id,
        # 2 = bluetooth (selects the widget's disconnect action), 1 = wireless;
        # cable-connected reports as wireless + charging, matching the HID
        # provider's wired devices.
        "connectionType": 2 if bluetooth else 1,
        "bluetooth_address": _read(device, "hid_serial") if bluetooth else None,
    }


def receiver_entries(receiver):
    """One receiver -> its paired devices' JSON dicts (stateless walk)."""
    entries = []
    # The whole walk is guarded: iterating a receiver does register reads
    # (Receiver.__iter__ -> count()) that can fail mid-iteration, dropping
    # the remaining devices for this run only.
    try:
        for paired in receiver:
            if paired is None:
                continue
            entry = device_entry(paired)
            if entry is not None:
                entries.append(entry)
    except Exception as error:
        debug(f"{receiver}: receiver walk failed ({error!r})")
    return entries


# HID++ unit id Solaar keeps for devices that have no unique unit serial
# ("distinguishes within a model", per Solaar itself) - not usable as identity.
_GENERIC_UNIT_ID = "00010000"


def _fold(entry, entries, by_identity):
    """Appends an entry unless the same device is already listed.

    Keyed by non-generic unitId with the serial as fallback, so a device
    reachable over several transports at once (multipoint: receiver +
    Bluetooth) is reported once - but only when both instances report a
    matching, actually-unique unitId; a side that reports none (or
    the generic placeholder) never collapses with anything. The Bluetooth
    instance wins the collapse: its MAC identity matches UPower's and it
    keeps the disconnect action.
    """
    unit = entry.get("unitId") or ""
    key = entry["serial"] if unit.upper() == _GENERIC_UNIT_ID else unit or entry["serial"]
    existing = by_identity.get(key)
    if existing is not None:
        if entry.get("connectionType") == 2 and entries[existing].get("connectionType") != 2:
            entries[existing] = entry
        return
    by_identity[key] = len(entries)
    entries.append(entry)


def collect(modules=None):
    """Device entries for every battery Solaar can read, plus blocked markers."""
    if modules is None:
        modules = load_modules()
    entries = []
    by_identity = {}
    blocked_reported = False
    try:
        for info in modules.base.receivers_and_devices():
            for item in open_items(modules, info):
                if isinstance(item, _Blocked):
                    # One marker per run: the rule is vendor-wide, so a second
                    # blocked node adds nothing to the copy-command flow.
                    if blocked_reported:
                        continue
                    blocked_reported = True
                    entries.append(
                        {
                            "name": f"Logitech device ({item.path})",
                            "serial": item.path,
                            "blocked": True,
                            "unblock_command": udev_unblock_command(),
                        }
                    )
                elif hasattr(item, "count"):  # Receiver / CenturionReceiver
                    for entry in receiver_entries(item):
                        _fold(entry, entries, by_identity)
                else:
                    entry = device_entry(item)
                    if entry is not None:
                        _fold(entry, entries, by_identity)
    finally:
        # Release every handle we opened; close() is idempotent and safe.
        try:
            for instance in list(modules.device.Device.instances):
                instance.close()
        except Exception as error:
            debug(f"cleanup failed ({error!r})")
    return entries


# ══════════════════════════════════════════════════════════════════════════
# cli - JSON output consumed by the widget
# ══════════════════════════════════════════════════════════════════════════
# Testing mode (no hardware): fake devices that mirror real behavior - they
# look blocked until the helper's udev rule exists, then report their battery.
_SIMULATE_DEVICES = [
    {"name": "MX Master 3S", "serial": "sim-mx-master-3s", "percentage": 72, "charging": False, "deviceType": "mouse"},
    {"name": "G733", "serial": "sim-g733", "percentage": 38, "charging": True, "deviceType": "audio-headset"},
    {"name": "MX Keys S", "serial": "sim-mx-keys-s", "percentage": 90, "charging": False, "deviceType": "keyboard"},
]


def simulate():
    if os.path.exists(udev_rule_path()):
        return _SIMULATE_DEVICES
    return [
        {
            key: device[key]
            for key in ("name", "serial", "deviceType")
        }
        | {"blocked": True, "unblock_command": udev_unblock_command()}
        for device in _SIMULATE_DEVICES
    ]


def read_real():
    """Real devices (a list), or an error object when Solaar is unusable."""
    # A cached `flatpak` runner skips host discovery entirely: the last good
    # run was inside Solaar's sandbox. If it turned stale, collect_flatpak()
    # clears it and this falls through to the normal host path.
    if cached_runner() == "flatpak":
        result = collect_flatpak()
        if result is not None:
            return result

    unavailable = None
    runtime_error = None
    try:
        return collect()
    except SolaarNotImportable as error:
        unavailable = error
        debug(f"host Solaar unusable: {error}")
    except Exception as error:  # e.g. pyudev breakage; the traceback stays on stderr
        runtime_error = error
        debug(f"host Solaar failed at runtime: {error!r}")

    # A Flatpak Solaar is a complete, isolated environment: hand the run over
    # to its own Python instead of the host one that cannot see the library.
    result = collect_flatpak()
    if result is not None:
        return result
    if runtime_error is not None:
        return {"error": "solaar-error", "hint": repr(runtime_error)}
    return {"error": "solaar-missing", "hint": str(unavailable)}


def main():
    result = read_real()
    if SIMULATE:
        # Testing mode adds the fake devices to the real ones.
        real = result if isinstance(result, list) else []
        result = simulate() + real
    print(json.dumps(result))


if __name__ == "__main__":
    main()
