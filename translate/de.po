#: ../metadata.desktop
msgid "BatteryWatch"
msgstr "BatteryWatch"

#: ../contents/config/config.qml
msgid "Appearance"
msgstr "Erscheinungsbild"

#: ../contents/config/config.qml
msgid "Integrations"
msgstr "Integrationen"

#: ../contents/config/config.qml
msgid "Advanced settings"
msgstr "Erweiterte Einstellungen"

#: ../contents/ui/config/AdvancedSettings.qml
msgid "Toggle Debug mode"
msgstr "Debug-Modus umschalten"

#: ../contents/ui/config/Appearance.qml
msgid "System Default (%1)"
msgstr "Systemstandard (%1)"

#: ../contents/ui/config/Appearance.qml
msgid "Tray Settings"
msgstr "Einstellungen des Infobereichs"

#: ../contents/ui/config/Appearance.qml
msgid "Font family:"
msgstr "Schriftart:"

#: ../contents/ui/config/Appearance.qml
msgid "Change the font family used for system tray text."
msgstr "Ändert die Schriftart des Textes im Infobereich."

#: ../contents/ui/config/Appearance.qml
msgid "Style"
msgstr "Stil"

#: ../contents/ui/config/Appearance.qml
msgid "Bold"
msgstr "Fett"

#: ../contents/ui/config/Appearance.qml
msgid ""
"Make the tray text bold.\n"
"Adjust weight between 100 and 1000."
msgstr ""
"Macht den Text im Infobereich fett.\n"
"Passt die Schriftdicke zwischen 100 und 1000 an."

#: ../contents/ui/config/Appearance.qml
msgid "Italic"
msgstr "Kursiv"

#: ../contents/ui/config/Appearance.qml
msgid "Make the tray text italic."
msgstr "Macht den Text im Infobereich kursiv."

#: ../contents/ui/config/Appearance.qml
msgid "Sizes"
msgstr "Größen"

#: ../contents/ui/config/Appearance.qml
msgid "Font"
msgstr "Schrift"

#: ../contents/ui/config/Appearance.qml
msgid "Adjust the size of tray text (in pixels)."
msgstr "Passt die Größe des Textes im Infobereich an (in Pixeln)."

#: ../contents/ui/config/Appearance.qml
msgid "Icon"
msgstr "Symbol"

#: ../contents/ui/config/Appearance.qml
msgid "Adjust the size of tray icons (in pixels)."
msgstr "Passt die Größe der Symbole im Infobereich an (in Pixeln)."

#: ../contents/ui/config/Appearance.qml
msgid "Spacing"
msgstr "Abstand"

#: ../contents/ui/config/Appearance.qml
msgid "Adjust the gap between tray icons (in pixels)."
msgstr "Passt den Abstand zwischen den Symbolen im Infobereich an (in Pixeln)."

#: ../contents/ui/config/Appearance.qml
msgid "Charging indicator"
msgstr "Ladeanzeige"

#: ../contents/ui/config/Appearance.qml
msgid "Show charging indicator in tray"
msgstr "Ladeanzeige im Infobereich anzeigen"

#: ../contents/ui/config/Appearance.qml
msgid "Battery Colors"
msgstr "Akkufarben"

#: ../contents/ui/config/Appearance.qml
msgid "Default"
msgstr "Standard"

#: ../contents/ui/config/Appearance.qml
msgid "Use when no other color state applies. When disabled, system color is used instead."
msgstr "Wird verwendet, wenn kein anderer Farbzustand zutrifft. Wenn deaktiviert, wird stattdessen die Systemfarbe verwendet."

#: ../contents/ui/config/Appearance.qml
msgid "Charging"
msgstr "Beim Laden"

#: ../contents/ui/config/Appearance.qml
msgid ""
"Overrides all other colors when device is charging.\n"
"Not all devices are currently supported!"
msgstr ""
"Überschreibt alle anderen Farben, wenn das Gerät geladen wird.\n"
"Nicht alle Geräte werden aktuell unterstützt!"

#: ../contents/ui/config/Appearance.qml
msgid "Zone 1"
msgstr "Zone 1"

#: ../contents/ui/config/Appearance.qml
msgid "≤"
msgstr "≤"

#: ../contents/ui/config/Appearance.qml
msgid "%"
msgstr "%"

#: ../contents/ui/config/Appearance.qml
msgid "Applied when battery falls below the set threshold."
msgstr "Wird angewendet, wenn der Akkustand unter den gesetzten Grenzwert fällt."

#: ../contents/ui/config/Appearance.qml
msgid "Zone 2"
msgstr "Zone 2"

#: ../contents/ui/config/Modules.qml
msgid "OpenLinkHub Integration"
msgstr "OpenLinkHub-Integration"

#: ../contents/ui/config/Modules.qml
msgid "Enable"
msgstr "Aktivieren"

#: ../contents/ui/config/Modules.qml
msgid "Port: "
msgstr "Port: "

#: ../contents/ui/config/Modules.qml
msgid "OpenRazer Integration"
msgstr "OpenRazer-Integration"

#: ../contents/ui/config/Modules.qml
msgid "Polling interval"
msgstr "Abfrageintervall"

#: ../contents/ui/config/Modules.qml
msgid "s"
msgstr "s"

#: ../contents/ui/config/Modules.qml
msgid "Sets the interval for OpenRazer device state updates."
msgstr "Legt das Intervall für die Aktualisierung des Gerätezustands von OpenRazer fest."

#: ../contents/ui/config/Modules.qml
msgid "KDE Connect Integration"
msgstr "KDE-Connect-Integration"

#: ../contents/ui/config/Modules.qml
msgid "Sets the interval for KDE Connect device state updates."
msgstr "Legt das Intervall für die Aktualisierung des Gerätezustands von KDE Connect fest."

#: ../contents/ui/config/Modules.qml
msgid "HID Devices Integration"
msgstr "HID-Geräte-Integration"

#: ../contents/ui/config/Modules.qml
msgid ""
"Sets the interval for re-checking HID devices when none are connected.\n"
"When a device is active, it updates automatically."
msgstr ""
"Legt das Intervall für das erneute Überprüfen von HID-Geräten fest, wenn keine Geräte verbunden sind.\n"
"Wenn ein Gerät aktiv ist, wird die Aktualisierung automatisch durchgeführt."

#. i18n: %1 is the version number.
#: ../contents/ui/main.qml
msgid "BatteryWatch v%1"
msgstr "BatteryWatch v%1"

#: ../contents/ui/main.qml
msgid "No connected devices"
msgstr "Keine Geräte verbunden"

#: ../contents/ui/main.qml
msgid "%1 - permission needed"
msgstr "%1 – Berechtigung erforderlich"

#. i18n: %1 can be the device name or, in the case of multiple batteries, the battery label,
#. or simply the word, ‘Battery’. %2 is the charge percentage value.
#: ../contents/ui/main.qml
msgid "%1: %2%"
msgstr "%1: %2%"

#. i18n: The delimiter when listing multiple batteries in the same device.
#: ../contents/ui/main.qml
msgid ", "
msgstr ", "

#. i18n: Used when there are multiple batteries in a device.
#. %1 is the device name.
#. %2 is the delimited list of the device's batteries and their charge percentages.
#: ../contents/ui/main.qml
msgid "%1 - %2"
msgstr "%1 - %2"

#: ../contents/ui/main.qml
msgid "All devices hidden"
msgstr "Alle Geräte versteckt"

#. i18n: %1 is the charge percentage value; the trailing % is a literal percent sign.
#: ../contents/ui/main.qml
msgid "%1%"
msgstr "%1%"

#: ../contents/ui/main.qml
msgid "Device Battery Levels"
msgstr "Akkustände der Geräte"

#: ../contents/ui/main.qml
msgid "Refresh"
msgstr "Aktualisieren"

#: ../contents/ui/main.qml
msgid "Refresh devices"
msgstr "Geräte aktualisieren"

#: ../contents/ui/main.qml ../contents/ui/providers/CompanionProvider.qml ../contents/ui/providers/HIDDevicesProvider.qml ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Unknown Device"
msgstr "Unbekanntes Gerät"

#: ../contents/ui/main.qml
msgid "Permission needed - run the command in a terminal"
msgstr "Berechtigung erforderlich – führen Sie den Befehl in einem Terminal aus"

#: ../contents/ui/main.qml
msgid "Battery"
msgstr "Akku"

#. i18n: %1 is the battery label or simply the word, ‘Battery’. %2 is the charge percentage value.
#. %3 is a Unicode lightning symbol displayed when the device is charging.
#: ../contents/ui/main.qml
msgid "%1: <span style=\"color:%4\">%2%</span>%3"
msgstr "%1: <span style=\"color:%4\">%2%</span>%3"

#: ../contents/ui/main.qml
msgid "Disconnect"
msgstr "Trennen"

#: ../contents/ui/main.qml ../contents/ui/providers/CompanionProvider.qml ../contents/ui/providers/UPowerProvider.qml
msgid "Disconnect device"
msgstr "Gerät trennen"

#: ../contents/ui/main.qml
msgid "Hide"
msgstr "Verstecken"

#: ../contents/ui/main.qml
msgid "Show"
msgstr "Anzeigen"

#: ../contents/ui/main.qml
msgid "Hide from tray"
msgstr "Aus dem Infobereich ausblenden"

#: ../contents/ui/main.qml
msgid "Show in tray"
msgstr "Im Infobereich anzeigen"

#: ../contents/ui/main.qml
msgid "Copied!"
msgstr "Kopiert!"

#: ../contents/ui/main.qml
msgid "Copy command"
msgstr "Befehl kopieren"

#: ../contents/ui/main.qml
msgid "Copied to clipboard"
msgstr "In die Zwischenablage kopiert"

#: ../contents/ui/main.qml
msgid "Copy the command to run in a terminal"
msgstr "Befehl zum Ausführen in einem Terminal kopieren"

#. i18n: %1 is the charge percentage value, %2 is an optional charging indicator suffix (e.g. " ⚡") or empty string. %% is a literal percent sign.
#: ../contents/ui/main.qml
msgid "%1%%2"
msgstr "%1%%2"

#: ../contents/ui/main.qml
msgid "No connected devices with battery info found"
msgstr "Keine verbundenen Geräte mit Akkuinformationen gefunden"

#: ../contents/ui/providers/CompanionProvider.qml
msgid "BatteryWatch: Companion service disconnected"
msgstr "BatteryWatch: Companion-Dienst getrennt"

#: ../contents/ui/providers/CompanionProvider.qml
msgid "BatteryWatch: Companion service connected"
msgstr "BatteryWatch: Companion-Dienst verbunden"

#: ../contents/ui/providers/CompanionProvider.qml
msgid "BatteryWatch: Failed to parse companion data:"
msgstr "BatteryWatch: Die Companion-Daten konnten nicht verarbeitet werden:"

#: ../contents/ui/providers/KDEConnectProvider.qml
msgid "Unpair KDE Connect device"
msgstr "KDE-Connect-Gerät entkoppeln"

#: ../contents/ui/providers/KDEConnectProvider.qml
msgid "BatteryWatch: KDE Connect daemon unavailable"
msgstr "BatteryWatch: KDE-Connect-Daemon nicht verfügbar"

#: ../contents/ui/providers/KDEConnectProvider.qml
msgid "BatteryWatch: KDE Connect daemon connected"
msgstr "BatteryWatch: KDE-Connect-Daemon verbunden"

#. i18n: %1 is the number of devices found.
#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Devices found: %1"
msgstr "Gefundene Geräte: %1"

#. i18n: %1 is the error.
#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Server error: %1"
msgstr "Serverfehler: %1"

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Server responded without any battery data!"
msgstr "Der Server hat keine Akkudaten zurückgegeben!"

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Failed to parse battery data:"
msgstr "Die Akkudaten konnten nicht verarbeitet werden:"

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Invalid battery data received:"
msgstr "Ungültige Akkudaten empfangen:"

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Invalid device data for serial:"
msgstr "Ungültige Gerätedaten für Seriennummer:"

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Error processing battery data:"
msgstr "Fehler bei der Verarbeitung der Akkudaten:"

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Invalid battery device data, skipping"
msgstr "Ungültige Akkugerätedaten - wird übersprungen"

#. i18n: %1 is the serial number of the device.
#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Device '%1' is not connected, removing."
msgstr "Gerät '%1' ist nicht verbunden und wird entfernt."

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Processed devices:"
msgstr "Verarbeitete Geräte:"

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Invalid device data received for device creation"
msgstr "Ungültige Gerätedaten zum Erstellen des Geräts empfangen"

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Invalid battery device data for device creation"
msgstr "Ungültige Akkugerätedaten zum Erstellen des Geräts"

#. i18n: %1 is the serial number of the device.
#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Device '%1' is not connected, skipping."
msgstr "Gerät '%1' ist nicht verbunden und wird übersprungen."

#. i18n: %1 is the serial number of the device.
#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Fetching device data for serial: %1"
msgstr "Gerätedaten für die Seriennummer werden abgerufen: %1"

#. i18n: %1 is the serial number of the device.
#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Successfully fetched device data for serial: %1"
msgstr "Gerätedaten für die Seriennummer erfolgreich abgerufen: %1"

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Failed to parse device data:"
msgstr "Die Gerätedaten konnten nicht verarbeitet werden:"

#. i18n: %1 is the serial number of the device.
#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Server error fetching device '%1':"
msgstr "Serverfehler beim Abrufen des Geräts '%1':"

#: ../contents/ui/providers/OpenRazerProvider.qml
msgid "Unknown Razer Device"
msgstr "Unbekanntes Razer-Gerät"

#. i18n: Used when a device is known by BatteryWatch to be misreported by UPower.
#. %1 is the device's model name. %2 is the erroneously reported device type (e.g.: ‘mouse’).
#. %3 is the correct device type.
#: ../contents/ui/providers/UPowerProvider.qml
msgid "BatteryWatch: Applying UPower device override for '%1': %2 -> %3"
msgstr "BatteryWatch: UPower-Gerätetyp für '%1' wird überschrieben: %2 → %3"
