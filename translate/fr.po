msgid "Toggle Debug mode"
msgstr "Activer le mode débogage"

#: ../contents/ui/config/Appearance.qml
msgid "System Default (%1)"
msgstr "Système par defaut (%1)"

#: ../contents/ui/config/Appearance.qml
msgid "Tray Settings"
msgstr "Paramètres de la zone de notification"

#: ../contents/ui/config/Appearance.qml
msgid "Font family:"
msgstr "Famille de police d'écriture :"

#: ../contents/ui/config/Appearance.qml
msgid "Change the font family used for system tray text."
msgstr "Modifier la police d'écriture utilisée pour le texte de la zone de notification."

#: ../contents/ui/config/Appearance.qml
msgid "Style"
msgstr "Style"

#: ../contents/ui/config/Appearance.qml
msgid "Bold"
msgstr "Gras"

#: ../contents/ui/config/Appearance.qml
msgid ""
"Make the tray text bold.\n"
"Adjust weight between 100 and 1000."
msgstr ""
"Mettre le texte de la barre en gras.\n"
"Ajuste la taille entre 100 et 1000."

#: ../contents/ui/config/Appearance.qml
msgid "Italic"
msgstr "Italique"

#: ../contents/ui/config/Appearance.qml
msgid "Make the tray text italic."
msgstr "Mettre le texte de la barre en italique."

#: ../contents/ui/config/Appearance.qml
msgid "Sizes"
msgstr "Tailles"

#: ../contents/ui/config/Appearance.qml
msgid "Font"
msgstr "Police d'écriture"

#: ../contents/ui/config/Appearance.qml
msgid "Adjust the size of tray text (in pixels)."
msgstr "Ajuster la taille du texte de la barre (en pixels)."

#: ../contents/ui/config/Appearance.qml
msgid "Icon"
msgstr "Icône"

#: ../contents/ui/config/Appearance.qml
msgid "Adjust the size of tray icons (in pixels)."
msgstr "Ajuster la taille de l'icône de la barre (en pixels)."

#: ../contents/ui/config/Appearance.qml
msgid "Spacing"
msgstr "Espacement"

#: ../contents/ui/config/Appearance.qml
msgid "Adjust the gap between tray icons (in pixels)."
msgstr "Ajuster l'espace entre les icônes de la barre (en pixels)."

#: ../contents/ui/config/Appearance.qml
msgid "Charging indicator"
msgstr "Indicateur de charge"

#: ../contents/ui/config/Appearance.qml
msgid "Show charging indicator in tray"
msgstr "Afficher l'indicateur de charge dans la barre"

#: ../contents/ui/config/Appearance.qml
msgid "Battery Colors"
msgstr "Couleurs de la batterie"

#: ../contents/ui/config/Appearance.qml
msgid "Default"
msgstr "Par défaut"

#: ../contents/ui/config/Appearance.qml
msgid "Use when no other color state applies. When disabled, system color is used instead."
msgstr "Utiliser quand aucune autre couleur ne s'applique. Quand désactivé, la couleur du système sont utilisée à la place."

#: ../contents/ui/config/Appearance.qml
msgid "Charging"
msgstr "En charge"

#: ../contents/ui/config/Appearance.qml
msgid ""
"Overrides all other colors when device is charging.\n"
"Not all devices are currently supported!"
msgstr ""
"Remplace toutes les autres couleurs quand le périphérique charge.\n"
"Certains périphériques ne sont pas pris en charge pour le moment !"

#: ../contents/ui/config/Appearance.qml
msgid "Zone 1"
msgstr "Zone 1"

#: ../contents/ui/config/Appearance.qml
msgid "≤"
msgstr "≤"

#: ../contents/ui/config/Appearance.qml ../contents/ui/config/Notifications.qml
msgid "%"
msgstr "%"

#: ../contents/ui/config/Appearance.qml
msgid "Applied when battery falls below the set threshold."
msgstr "Appliqué quand la batterie tombe sous le seuil indiqué."

#: ../contents/ui/config/Appearance.qml
msgid "Zone 2"
msgstr "Zone 2"

#: ../contents/ui/config/Modules.qml
msgid "UPower Integration"
msgstr "Intégration UPower"

#: ../contents/ui/config/Modules.qml
msgid "Enable"
msgstr "Activer"

#: ../contents/ui/config/Modules.qml
msgid "OpenLinkHub Integration"
msgstr "Intégration OpenLinkHub"

#: ../contents/ui/config/Modules.qml
msgid "Port: "
msgstr "Port : "

#: ../contents/ui/config/Modules.qml
msgid "OpenRazer Integration"
msgstr "Intégration OpenRazer"

#: ../contents/ui/config/Modules.qml
msgid "Polling interval"
msgstr "Intervalle d'interrogation"

#: ../contents/ui/config/Modules.qml
msgid "s"
msgstr "s"

#: ../contents/ui/config/Modules.qml
msgid "Sets the interval for OpenRazer device state updates."
msgstr "Definir l'intervalle de mise à jour pour l'état du périphérique OpenRazer."

#: ../contents/ui/config/Modules.qml
msgid "KDE Connect Integration"
msgstr "Intégration KDE Connect"

#: ../contents/ui/config/Modules.qml
msgid "Sets the interval for KDE Connect device state updates."
msgstr "Definir l'intervalle de mise à jour pour l'état du périphérique KDE Connect."

#: ../contents/ui/config/Modules.qml
msgid "BlueZ Integration"
msgstr "Intégration BlueZ"

#: ../contents/ui/config/Modules.qml
msgid "Sets the interval for polling BlueZ for the battery updates of connected devices."
msgstr "Definir l'intervalle d'interrogation de BlueZ pour les mises à jour de batterie des périphériques connectés."

#: ../contents/ui/config/Modules.qml
msgid "HID Devices Integration"
msgstr "Intégration des périphériques HID"

#: ../contents/ui/config/Modules.qml
msgid ""
"Sets the interval for re-checking HID devices when none are connected.\n"
"When a device is active, it updates automatically."
msgstr ""
"Definir l'intervalle pour revérifié les périphériques HID quand aucun n'est connecté.\n"
"Quand un périphérique est actif, il est mis à jour automatiquement."

#: ../contents/ui/config/Modules.qml
msgid "Solaar Integration"
msgstr "Intégration Solaar"

#: ../contents/ui/config/Modules.qml
msgid ""
"Sets the interval for Solaar device state updates.\n"
"Requires Solaar to be installed; Logitech devices only."
msgstr ""
"Definir l'intervalle de mise à jour pour l'état du périphérique Solaar.\n"
"Nécessite que Solaar soit installé ; périphériques Logitech uniquement."

#: ../contents/ui/config/Modules.qml
msgid "HeadsetControl Integration"
msgstr "Intégration HeadsetControl"

#: ../contents/ui/config/Modules.qml
msgid "Sets the interval for HeadsetControl battery updates."
msgstr "Definir l'intervalle de mise à jour de la batterie pour HeadsetControl."

#: ../contents/ui/config/Notifications.qml ../contents/ui/DeviceRow.qml
msgid "Enable Notification"
msgstr "Activer la notification"

#: ../contents/ui/config/Notifications.qml
msgid "Threshold"
msgstr "Seuil"

#: ../contents/ui/config/Notifications.qml
msgid "Shows system notification when battery falls below the set threshold."
msgstr "Affiche une notification système quand la batterie passe sous le seuil défini."

#: ../contents/ui/config/Updates.qml
msgid "Update checks"
msgstr "Vérification des mises à jour"

#: ../contents/ui/config/Updates.qml
msgid "Check for updates"
msgstr "Rechercher des mises à jour"

#: ../contents/ui/config/Updates.qml
msgid "Periodically asks GitHub for the latest BatteryWatch release. No data is sent."
msgstr "Demande périodiquement à GitHub la dernière version de BatteryWatch. Aucune donnée n'est envoyée."

#: ../contents/ui/config/Updates.qml
msgid "How to notify"
msgstr "Mode de notification"

#: ../contents/ui/config/Updates.qml
msgid "Tooltip hint"
msgstr "Indication dans l'infobulle"

#: ../contents/ui/config/Updates.qml
msgid "(Update available) appended when hovering the tray icon"
msgstr "« (Mise à jour disponible) » est ajouté au survol de l'icône de la barre"

#: ../contents/ui/config/Updates.qml
msgid "Header pill"
msgstr "Pastille d'en-tête"

#: ../contents/ui/config/Updates.qml
msgid "Dismissible download chip in the popup header"
msgstr "Pastille de téléchargement masquable dans l'en-tête de la fenêtre"

