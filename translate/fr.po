msgid "Disable Notification"
msgstr "Désactiver la notification"

#: ../contents/ui/DeviceRow.qml
msgid "Copied!"
msgstr "Copié !"

#: ../contents/ui/DeviceRow.qml
msgid "Copy command"
msgstr "Copier la commande"

