msgid "Show"
msgstr "Afficher"

#: ../contents/ui/DeviceRow.qml
msgid "Hide"
msgstr "Masquer"

#: ../contents/ui/DeviceRow.qml
msgid "Show in tray"
msgstr "Afficher dans la barre"

#: ../contents/ui/DeviceRow.qml
msgid "Hide from tray"
msgstr "Masquer de la barre"

