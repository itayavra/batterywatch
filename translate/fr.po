msgstr "%1%%2"

#: ../contents/ui/main.qml
msgid "Low battery"
msgstr "Batterie faible"

#: ../contents/ui/main.qml
msgid "Device"
msgstr "Périphérique"

#: ../contents/ui/main.qml
msgid "%1%2 has %3% battery remaining"
msgstr "%1%2 a %3% de batterie restante"

#. i18n: %1 is the version number.
#: ../contents/ui/main.qml
msgid "BatteryWatch v%1 (Update available)"
msgstr "BatteryWatch v%1 (Mise à jour disponible)"

#. i18n: %1 is the version number.
#: ../contents/ui/main.qml
msgid "BatteryWatch v%1"
msgstr "BatteryWatch v%1"

#: ../contents/ui/main.qml
msgid "No connected devices"
msgstr "Aucun périphérique connecté"

#: ../contents/ui/main.qml
msgid "%1 - permission needed"
msgstr "%1 - permission requise"

#. i18n: %1 can be the device name or, in the case of multiple batteries, the battery label,
#. or simply the word, ‘Battery’. %2 is the charge percentage value.
#: ../contents/ui/main.qml
msgid "%1: %2%"
msgstr "%1 : %2%"

#. i18n: The delimiter when listing multiple batteries in the same device.
#: ../contents/ui/main.qml
msgid ", "
msgstr ", "

#. i18n: Used when there are multiple batteries in a device.
#. %1 is the device name.
#. %2 is the delimited list of the device's batteries and their charge percentages.
#: ../contents/ui/main.qml
msgid "%1 - %2"
msgstr "%1 - %2"

#: ../contents/ui/main.qml
msgid "All devices hidden"
msgstr "Tous les périphériques sont masqués"

#: ../contents/ui/main.qml
msgid "Device Battery Levels"
msgstr "Niveaux de batterie des périphérique"

#: ../contents/ui/main.qml
msgid "Refresh"
msgstr "Actualiser"

#: ../contents/ui/main.qml
msgid "Refresh devices"
msgstr "Actualiser les périphériques"

#: ../contents/ui/main.qml
msgid "No connected devices with battery info found"
msgstr "Aucun périphérique avec informations de batterie trouvé"

#: ../contents/ui/providers/CompanionProvider.qml
msgid "BatteryWatch: Companion service disconnected"
msgstr "BatteryWatch : Service Companion déconnecté"

#: ../contents/ui/providers/CompanionProvider.qml
msgid "BatteryWatch: Companion service connected"
msgstr "BatteryWatch : Service Companion connecté"

#: ../contents/ui/providers/CompanionProvider.qml
msgid "BatteryWatch: Failed to parse companion data:"
msgstr "BatteryWatch : Échec de l'analyse des données du service Companion :"

#: ../contents/ui/providers/KDEConnectProvider.qml
msgid "Unpair KDE Connect device"
msgstr "Dissocier un périphérique KDE Connect"

#: ../contents/ui/providers/KDEConnectProvider.qml
msgid "BatteryWatch: KDE Connect daemon unavailable"
msgstr "BatteryWatch : démon KDE Connect indisponible"

#: ../contents/ui/providers/KDEConnectProvider.qml
msgid "BatteryWatch: unreadable KDE Connect reply (%1)"
msgstr "BatteryWatch : réponse KDE Connect illisible (%1)"

#: ../contents/ui/providers/KDEConnectProvider.qml
msgid "BatteryWatch: KDE Connect daemon connected"
msgstr "BatteryWatch : démon KDE Connect connecté"

#. i18n: %1 is the number of devices found.
#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Devices found: %1"
msgstr "Periphériques trouvés : %1"

#. i18n: %1 is the error.
#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Server error: %1"
msgstr "Erreur serveur : %1"

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Server responded without any battery data!"
msgstr "Le serveur a répondu sans aucune donnée de batterie !"

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Failed to parse battery data:"
msgstr "Échec de l'analyse des données de batterie :"

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Invalid battery data received:"
msgstr "Données de batterie invalides reçues :"

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Invalid device data for serial:"
msgstr "Données de périphérique invalides pour le numéro de série :"

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Error processing battery data:"
msgstr "Erreur lors du traitement des données de batterie :"

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Invalid battery device data, skipping"
msgstr "Données de périphérique de batterie invalides, ignorées"

#. i18n: %1 is the serial number of the device.
#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Device '%1' is not connected, removing."
msgstr "Le périphérique « %1 » n'est pas connecté, suppression."

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Processed devices:"
msgstr "Périphériques traités :"

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Invalid device data received for device creation"
msgstr "Données de périphérique invalides reçues pour la création du périphérique"

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Invalid battery device data for device creation"
msgstr "Données de batterie invalides pour la création du périphérique"

#. i18n: %1 is the serial number of the device.
#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Device '%1' is not connected, skipping."
msgstr "Le périphérique « %1 » n'est pas connecté, ignoré."

#. i18n: %1 is the serial number of the device.
#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Fetching device data for serial: %1"
msgstr "Récupération des données du périphérique pour le numéro de série : %1"

#. i18n: %1 is the serial number of the device.
#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Successfully fetched device data for serial: %1"
msgstr "Données du périphérique récupérées avec succès pour le numéro de série : %1"

#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Failed to parse device data:"
msgstr "Échec de l'analyse des données du périphérique :"

#. i18n: %1 is the serial number of the device.
#: ../contents/ui/providers/OpenLinkHubProvider.qml
msgid "Server error fetching device '%1':"
msgstr "Erreur du serveur lors de la récupération du périphérique « %1 » :"

#: ../contents/ui/providers/OpenRazerProvider.qml
msgid "Unknown Razer Device"
msgstr "Périphérique Razer inconnu"

#. i18n: %1 is the error message of the D-Bus call.
#: ../contents/ui/providers/OpenRazerProvider.qml
msgid "BatteryWatch: OpenRazer daemon unavailable (%1)"
msgstr "BatteryWatch : démon OpenRazer indisponible (%1)"

#: ../contents/ui/providers/OpenRazerProvider.qml
msgid "BatteryWatch: unreadable OpenRazer reply (%1)"
msgstr "BatteryWatch : réponse OpenRazer illisible (%1)"

#. i18n: %1 is the helper's hint why Solaar is unusable.
#: ../contents/ui/providers/SolaarProvider.qml
msgid "BatteryWatch: Solaar library unavailable (%1)"
msgstr "BatteryWatch : bibliothèque Solaar indisponible (%1)"

#. i18n: Used when a device is known by BatteryWatch to be misreported by UPower.
#. %1 is the device's model name. %2 is the erroneously reported device type (e.g.: ‘mouse’).
#. %3 is the correct device type.
#: ../contents/ui/providers/UPowerProvider.qml
msgid "BatteryWatch: Applying UPower device override for '%1': %2 -> %3"
msgstr "BatteryWatch : application de la substitution UPower du périphérique « %1 » : %2 -> %3"

#. i18n: %1 is the charge percentage value; the trailing % is a literal percent sign.
#: ../contents/ui/TrayDeviceItem.qml
msgid "%1%"
msgstr "%1%"

#: ../contents/ui/UpdatePill.qml
msgid "BatteryWatch v%1 is available — click to download"
msgstr "BatteryWatch v%1 est disponible — cliquez pour télécharger"

#: ../contents/ui/UpdatePill.qml
msgid "Update v%1"
msgstr "Mise à jour v%1"

#: ../contents/ui/UpdatePill.qml
msgid "Dismiss"
msgstr "Ignorer"

#: ../contents/ui/UpdatePill.qml
msgid "Hide until the next update"
msgstr "Masquer jusqu'à la prochaine mise à jour"
